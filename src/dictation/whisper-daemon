#!/usr/bin/env bash
# ==============================================================================
# whisper-daemon: CLI manager for WhisperPill background dictation
# ==============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN_PATH="$SCRIPT_DIR/whisper-pill"
PID_FILE="$HOME/.whisper-daemon.pid"
LOG_FILE="$HOME/.whisper-daemon.log"

usage() {
    cat << 'EOF'
Usage: whisper-daemon <command>

Commands:
  start     Start the Whisper dictation daemon in the background
  stop      Stop the running daemon
  restart   Restart the daemon
  status    Check if the daemon is currently running
  trigger   Trigger dictation (start/stop) via signal
  logs      View daemon output logs
  help      Show this help message

Hotkey:
  Hold 'Right Option' (⌥) to speak -> release to paste into active app!
  Or run 'whisper-daemon trigger' to toggle recording from anywhere.
EOF
    exit 0
}

is_running() {
    if [[ -f "$PID_FILE" ]]; then
        local pid
        pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

start_daemon() {
    if is_running; then
        echo "Whisper daemon is already running (PID: $(cat "$PID_FILE"))."
        return 0
    fi

    if [[ ! -f "$BIN_PATH" ]]; then
        echo "Error: Binary not found at $BIN_PATH" >&2
        exit 1
    fi

    echo "Starting Whisper background dictation daemon..."
    nohup "$BIN_PATH" > "$LOG_FILE" 2>&1 &
    local new_pid=$!
    echo "$new_pid" > "$PID_FILE"

    sleep 0.3
    if kill -0 "$new_pid" 2>/dev/null; then
        echo "✓ Daemon started successfully (PID: $new_pid)."
        echo "👉 Hotkey: Hold 'Right Option' (⌥) to speak, release to paste directly at cursor!"
    else
        echo "Failed to start daemon. Check logs at: $LOG_FILE" >&2
        rm -f "$PID_FILE"
        exit 1
    fi
}

stop_daemon() {
    if ! is_running; then
        echo "Whisper daemon is not running."
        rm -f "$PID_FILE"
        return 0
    fi

    local pid
    pid=$(cat "$PID_FILE")
    echo "Stopping Whisper daemon (PID: $pid)..."
    kill "$pid" 2>/dev/null || true
    sleep 0.3
    if kill -0 "$pid" 2>/dev/null; then
        kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
    echo "✓ Daemon stopped."
}

check_status() {
    if is_running; then
        local pid
        pid=$(cat "$PID_FILE")
        echo "● Whisper daemon is RUNNING (PID: $pid)"
        echo "  Binary:  $BIN_PATH"
        echo "  Hotkey:  Hold 'Right Option' (⌥) to speak, release to paste"
        echo "  Log:     $LOG_FILE"
    else
        echo "○ Whisper daemon is STOPPED"
    fi
}

trigger_dictation() {
    if is_running; then
        local pid
        pid=$(cat "$PID_FILE")
        kill -USR1 "$pid"
        echo "Triggered Whisper dictation toggle (PID: $pid)."
    else
        echo "Daemon is not running. Start it with: whisper-daemon start" >&2
        exit 1
    fi
}

tail_logs() {
    if [[ -f "$LOG_FILE" ]]; then
        tail -n 20 -f "$LOG_FILE"
    else
        echo "No logs yet at $LOG_FILE"
    fi
}

COMMAND="${1:-help}"

case "$COMMAND" in
    start)
        start_daemon
        ;;
    stop)
        stop_daemon
        ;;
    restart)
        stop_daemon
        start_daemon
        ;;
    status)
        check_status
        ;;
    trigger)
        trigger_dictation
        ;;
    logs)
        tail_logs
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        echo "Unknown command: $COMMAND" >&2
        usage
        ;;
esac
